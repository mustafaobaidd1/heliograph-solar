{
  "name": "heliograph-solar",
  "private": true,
  "version": "1.0.0",
  "description": "Track the sun anywhere on Earth and find the panel tilt and orientation that collect the most energy, with shading.",
  "type": "module",
  "license": "MIT",
  "author": "Mustafa Obaid",
  "homepage": "https://mustafaobaidd1.github.io/heliograph-solar/",
